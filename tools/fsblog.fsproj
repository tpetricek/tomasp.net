<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>fsblog</AssemblyName>
    <RootNamespace>FsBlog</RootNamespace>
    <Nullable>disable</Nullable>
    <WarningLevel>3</WarningLevel>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Date formatting uses the en-GB culture, so the invariant mode must stay off -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="domain.fs" />
    <Compile Include="helpers.fs" />
    <Compile Include="latex.fs" />
    <Compile Include="dotliquid.fs" />
    <Compile Include="document.fs" />
    <Compile Include="r2.fs" />
    <Compile Include="calendar.fs" />
    <Compile Include="blog.fs" />
    <Compile Include="main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Formatting" Version="22.1.0" />
    <PackageReference Include="DotLiquid" Version="2.3.197" />
    
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>
